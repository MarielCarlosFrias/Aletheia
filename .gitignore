# Artefatos de build e empacotamento
/build/
/build-*/
/cmake-build-*/
/_CPack_Packages/
/.qt/
*.o
*.obj
*.so
*.dll
*.dylib
*.a
*.exe
*.deb
*.zip

# Modelos (arquivos grandes, baixados a parte)
*.onnx

# ONNX Runtime extraido (dependencia externa)
onnxruntime-linux-x64-*/
onnxruntime-win-x64-*/
onnxruntime-osx-*/

# Excecao: o ONNX Runtime vendored em vendor/ e parte do repositorio
# (o release do GitHub foi removido; o build usa esta copia).
!/vendor/
!/vendor/onnxruntime/
!/vendor/onnxruntime/**
!vendor/onnxruntime/lib/*.so*
# Binarios Windows gerados por scripts/fetch-onnxruntime.sh no CI/dev local
# (DLL de ~15 MB e import lib sintetizada): nunca commitar.
vendor/onnxruntime/lib/*.dll
vendor/onnxruntime/lib/*.lib

# macOS: Qt instalado por aqtinstall, venv e ZIP de release
/Qt/
/.venv/
/dist/
.DS_Store

# AppImage gerado localmente
*.AppImage

# Saidas e imagens locais
/_rembg/
/_rembg_output/
/_rembg_cli_test/
/imagens/
/imagens_teste/
/teste.png
/teste.jpg
/resultado*.png

# Atalhos e rascunhos locais
/bg_remover_cli
*.bak

# Logs de ferramentas (aqtinstall, etc.)
aqtinstall.log
